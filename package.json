{
  "name": "starter",
  "private": true,
  "scripts": {
    "setup-project": "tsx scripts/setup-project.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "oxlint --quiet --type-aware --type-check",
    "lint:fix": "oxlint --quiet --fix --type-aware --type-check",
    "format": "oxfmt --quiet --check",
    "format:fix": "oxfmt",
    "quality": "pnpm run --stream '/^(lint|format)$/'",
    "quality:fix": "pnpm run --stream '/^(lint:fix|format:fix)$/'",
    "f": "pnpm --filter",
    "cleanup": "rimraf --glob \"**/{.cache,.turbo,.output,.tanstack,.nitro,dist,node_modules}\"",
    "prepare": "husky",
    "compose:up": "docker compose up --build --force-recreate --no-deps"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "es-toolkit": "^1.45.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.61.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "rimraf": "^6.1.3",
    "tsx": "4.21.0",
    "turbo": "2.9.6",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "@parcel/watcher"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
