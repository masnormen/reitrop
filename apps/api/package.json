{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --convention=nextjs -- tsx watch src/index.ts",
    "build": "dotenvx run --convention=nextjs -- tsx build.ts",
    "start": "NODE_ENV=production dotenvx run --convention=nextjs -- node dist/index.js",
    "test": "pnpm root-env:dev -- node index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.13",
    "@hono/zod-openapi": "1.2.4",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@scalar/hono-api-reference": "0.10.7",
    "hono": "4.12.12",
    "hono-pino": "0.10.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "stoker": "2.0.1",
    "zod": "4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "esbuild": "^0.28.0"
  }
}
