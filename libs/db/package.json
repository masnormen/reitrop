{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schemas/__schema__.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenvx run --convention=nextjs drizzle-kit generate",
    "db:migrate": "dotenvx run --convention=nextjs drizzle-kit migrate",
    "db:studio": "dotenvx run --convention=nextjs drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-cuid2": "^2.2.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
